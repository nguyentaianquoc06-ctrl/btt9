package b21;

import java.util.ArrayList;
import java.util.List;

abstract class FileSystemItem {
	protected String name;
	protected String path;

	public FileSystemItem(String name, String path) {
		this.name = name;
		this.path = path;
	}

	public abstract void print(String indent);

	public String getPath() {
		return path;
	}
}

class FileItem extends FileSystemItem {
	private int size;

	public FileItem(String name, int size, String path) {
		super(name, path);
		this.size = size;
	}

	@Override
	public void print(String indent) {
		System.out.println(indent + "File: " + name + " (" + size + "KB)");
	}
}

class Shortcut extends FileSystemItem {
	private FileSystemItem target;

	public Shortcut(String name, FileSystemItem target, String path) {
		super(name, path);
		this.target = target;
	}

	@Override
	public void print(String indent) {
		System.out.println(indent + "Shortcut: " + name + " -> " + target.getPath());
	}
}

class Folder extends FileSystemItem {
	private List<FileSystemItem> children;

	public Folder(String name, String path) {
		super(name, path);
		children = new ArrayList<>();
	}

	public void add(FileSystemItem item) {
		children.add(item);
	}

	@Override
	public void print(String indent) {
		System.out.println(indent + "Folder: " + name);

		for (FileSystemItem item : children) {
			item.print(indent + "  ");
		}
	}
}

public class Main {
	public static void main(String[] args) {

		FileItem fileA = new FileItem("a.txt", 12, "/root/docs/a.txt");

		FileItem fileB = new FileItem("b.txt", 8, "/root/docs/b.txt");

		FileItem readme = new FileItem("readme.md", 4, "/root/readme.md");

		Shortcut shortcut = new Shortcut("a-shortcut", fileA, "/root/docs/a-shortcut");

		Folder docs = new Folder("docs", "/root/docs");

		docs.add(fileA);
		docs.add(fileB);
		docs.add(shortcut);

		Folder root = new Folder("root", "/root");

		root.add(docs);
		root.add(readme);
		root.print("");
	}
}
